# Copia este archivo a .env.local (no se sube a git) y rellénalo con la configuración
# de tu app web de Firebase: Consola de Firebase → Configuración del proyecto → Tus apps.
# Estos valores no son secretos (acaban en el JavaScript público); la seguridad la dan firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Desarrollo sin proyecto real: usa los emuladores locales (ver README).
# VITE_FIREBASE_PROJECT_ID=demo-juego-matematico
# VITE_FIREBASE_USE_EMULATORS=true
