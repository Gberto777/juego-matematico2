# Copia este archivo a .env.local (no se sube a git) y rellénalo.
# Estos valores no son secretos (acaban en el JavaScript público); la seguridad la dan las
# políticas RLS de Supabase y las reglas de Firestore.

# --- Supabase (backend común de MathQuest: web, móvil y Godot) ---
# Panel de Supabase → Project Settings → API. Usa la clave pública (publishable/anon),
# NUNCA la clave secreta (service_role).
# En local con `npx supabase start`: http://127.0.0.1:54321 y la clave que muestra el comando.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Firebase (modo aula actual; se retirará cuando las salas pasen a Supabase) ---
# Consola de Firebase → Configuración del proyecto → Tus apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Desarrollo sin proyecto real de Firebase: usa los emuladores locales (ver README).
# VITE_FIREBASE_PROJECT_ID=demo-juego-matematico
# VITE_FIREBASE_USE_EMULATORS=true
