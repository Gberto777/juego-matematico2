  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.3",
